<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="270dp">

                <ImageView
                    android:id="@+id/dest_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim" />

                <TextView
                    android:id="@+id/btn_back"
                    style="@style/Diar.IconButton"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="@dimen/gutter"
                    android:layout_marginTop="44dp"
                    android:contentDescription="@string/back"
                    android:text="→" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:orientation="vertical"
                    android:padding="@dimen/gutter">

                    <TextView
                        android:id="@+id/dest_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dest_tagline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#E1E9E2"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/gutter">

                <TextView
                    android:id="@+id/dest_count"
                    style="@style/Diar.Muted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/dest_about"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <!-- تبويبات: نظرة عامة / تجارب / أماكن قريبة -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tab_overview"
                        style="@style/Diar.Pill"
                        android:background="@drawable/bg_btn_green"
                        android:text="@string/tab_overview"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tab_experiences"
                        style="@style/Diar.Pill"
                        android:text="@string/tab_experiences" />

                    <TextView
                        android:id="@+id/tab_nearby"
                        style="@style/Diar.Pill"
                        android:text="@string/tab_nearby" />
                </LinearLayout>

                <TextView
                    style="@style/Diar.Section"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dont_miss" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/pick1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/pick1_img"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/pick1_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/pick1_price"
                            style="@style/Diar.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pick2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/pick2_img"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:id="@+id/pick2_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/pick2_price"
                            style="@style/Diar.Muted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_map"
                    style="@style/Diar.Button"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_btn_outline"
                    android:text="@string/show_on_map"
                    android:textColor="@color/green" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
