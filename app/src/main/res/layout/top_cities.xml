<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingStart="@dimen/gutter"
    android:paddingTop="4dp"
    android:paddingEnd="@dimen/gutter"
    android:paddingBottom="8dp"
    android:scrollbars="none">

    <RadioGroup
        android:id="@+id/city_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkedButton="@+id/c_all"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/c_all"
            style="@style/Diar.Pill"
            android:text="@string/mood_all" />

        <RadioButton
            android:id="@+id/c_riyadh"
            style="@style/Diar.Pill"
            android:text="@string/city_riyadh" />

        <RadioButton
            android:id="@+id/c_alula"
            style="@style/Diar.Pill"
            android:text="@string/city_alula" />

        <RadioButton
            android:id="@+id/c_abha"
            style="@style/Diar.Pill"
            android:text="@string/city_abha" />
    </RadioGroup>
</HorizontalScrollView>
