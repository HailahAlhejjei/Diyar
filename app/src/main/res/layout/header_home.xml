<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/gutter"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/gutter">

    <!-- التحية + الإشعارات -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Diar.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_question" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_saved"
            style="@style/Diar.IconButton"
            android:layout_marginEnd="8dp"
            android:contentDescription="@string/saved_title"
            android:text="♡" />

        <TextView
            android:id="@+id/btn_notices"
            style="@style/Diar.IconButton"
            android:contentDescription="@string/notices_title"
            android:text="🔔" />
    </LinearLayout>

    <!-- البحث: يفتح شاشة البحث -->
    <TextView
        android:id="@+id/search_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input"
        android:padding="14dp"
        android:text="@string/search_hint"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <!-- وجهة الأسبوع -->
    <FrameLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_image_round">

        <ImageView
            android:id="@+id/hero_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/onb_1" />

        <View
            android:id="@+id/hero_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_hero_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="@string/week_pick"
                android:textColor="#4F3210"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/week_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/week_sub"
                android:textColor="#E1E9E2"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- الوجهات -->
    <TextView
        style="@style/Diar.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/destinations" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/city_riyadh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/city_riyadh_img"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/img_turaif" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/city_riyadh"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/city_alula"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/city_alula_img"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/onb_1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/city_alula"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/city_abha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/city_abha_img"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/img_soudah" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/city_abha"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- مزاج الرحلة -->
    <TextView
        style="@style/Diar.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mood_title" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <RadioGroup
            android:id="@+id/mood_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checkedButton="@+id/mood_all"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/mood_all"
                style="@style/Diar.Pill"
                android:text="@string/mood_all" />

            <RadioButton
                android:id="@+id/mood_adventure"
                style="@style/Diar.Pill"
                android:text="@string/mood_adventure" />

            <RadioButton
                android:id="@+id/mood_relax"
                style="@style/Diar.Pill"
                android:text="@string/mood_relax" />

            <RadioButton
                android:id="@+id/mood_culture"
                style="@style/Diar.Pill"
                android:text="@string/mood_culture" />
        </RadioGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/mood_count"
        style="@style/Diar.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp" />
</LinearLayout>
